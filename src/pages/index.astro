---
import { getEntry, render } from "astro:content";
import PageLayout from "@layouts/page-layout.astro";

const homePage = await getEntry("pages", "home/home");
if (!homePage) {
  throw new Error("home page entry not found");
}
const { Content } = await render(homePage);
---

<PageLayout {...homePage.data}>
  <Content />
</PageLayout>
